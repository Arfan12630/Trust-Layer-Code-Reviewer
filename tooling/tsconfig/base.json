{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"module": "preserve",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false
	}
}
